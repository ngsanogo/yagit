# Optional machine-specific settings for `mise run dev` / `./do up`.
# Copy to .env (never committed). Every variable is read by the daemon itself.

# The root under which yagit may open repositories — a security boundary: the
# daemon refuses anything outside it. Defaults to your home directory.
# YAGIT_ROOT=/home/you/code

# Browsing from another machine — pick ONE:
#
# 1. Through a reverse proxy on this machine (recommended). The daemon stays on
#    127.0.0.1:7420; point the proxy there, pass WebSocket upgrades through,
#    leave responses unbuffered and send X-Forwarded-Proto.
# YAGIT_PUBLIC_URL=https://yagit.example.test
#
# 2. Straight to the daemon by the machine's name. This makes it listen on all
#    interfaces (the session token still guards every route).
# YAGIT_PUBLIC_HOST=devbox.local
# YAGIT_LISTEN_ALL=1
