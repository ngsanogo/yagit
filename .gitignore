# Binaries produced by `./do build`
/dist/

# Built frontend, embedded in the Go binary — regenerated by `./do build`.
# The .gitkeep itself is tracked: it guarantees //go:embed finds at least one
# file in a freshly cloned repository.
/internal/assets/dist/*
!/internal/assets/dist/.gitkeep

# Node dependencies, installed by `./do` from web/package-lock.json
/web/node_modules/

# Local machine configuration (the YAGIT_ROOT path) — never tracked
/.env

# Personal agent overrides — never tracked. The two `local` rule files are one
# document in two formats, because the two tools read different ones; they are
# written by hand rather than by `./do agent sync`, which only generates what
# is tracked.
/CLAUDE.local.md
/cursor/rules/local.mdc
/claude/settings.local.json
/cursor/settings.local.json

# Runtime state: session token, e2e fixtures, air's build directory, logs,
# screenshots. One directory rather than three scattered ones, and air is given
# a subdirectory of it rather than the whole thing — see .air.toml.
/.yagit/

# Playwright artifacts. Unanchored patterns: Playwright writes under web/, not
# at the root, and an anchored pattern would let through exactly what it was
# meant to block.
test-results/
playwright-report/
