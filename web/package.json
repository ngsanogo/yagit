{
  "name": "yagit-web",
  "private": true,
  "description": "yagit's web frontend: the design system and the interface served by the daemon.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=26.11.1",
    "pnpm": ">=12.9.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:release": "playwright test --config playwright.release.config.ts",
    "lint": "tsc --noEmit && oxlint --deny-warnings",
    "fmt": "prettier --write .",
    "test:coverage": "vitest run --coverage",
    "fmt:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-virtual": "3.14.15",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
